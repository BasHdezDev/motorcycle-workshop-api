{
    "displayName": "Motorcycle Workshop - Canary (stable vs canary)",
    "mosaicLayout": {
        "columns": 12,
        "tiles": [
            {
                "xPos": 0,
                "yPos": 0,
                "width": 6,
                "height": 4,
                "widget": {
                    "title": "Traffic: requests per second by revision",
                    "xyChart": {
                        "dataSets": [
                            {
                                "plotType": "STACKED_AREA",
                                "legendTemplate": "${resource.labels.revision_name}",
                                "timeSeriesQuery": {
                                    "timeSeriesFilter": {
                                        "filter": "metric.type=\"run.googleapis.com/request_count\" resource.type=\"cloud_run_revision\" resource.labels.service_name=\"workshop-v3-api\"",
                                        "aggregation": {
                                            "alignmentPeriod": "60s",
                                            "perSeriesAligner": "ALIGN_RATE",
                                            "crossSeriesReducer": "REDUCE_SUM",
                                            "groupByFields": [
                                                "resource.labels.revision_name"
                                            ]
                                        }
                                    }
                                }
                            }
                        ]
                    }
                }
            },
            {
                "xPos": 6,
                "yPos": 0,
                "width": 6,
                "height": 4,
                "widget": {
                    "title": "Errors: 4xx and 5xx per second by revision",
                    "xyChart": {
                        "dataSets": [
                            {
                                "plotType": "LINE",
                                "legendTemplate": "${metric.labels.response_code_class} ${resource.labels.revision_name}",
                                "timeSeriesQuery": {
                                    "timeSeriesFilter": {
                                        "filter": "metric.type=\"run.googleapis.com/request_count\" resource.type=\"cloud_run_revision\" resource.labels.service_name=\"workshop-v3-api\" metric.labels.response_code_class=one_of(\"4xx\",\"5xx\")",
                                        "aggregation": {
                                            "alignmentPeriod": "60s",
                                            "perSeriesAligner": "ALIGN_RATE",
                                            "crossSeriesReducer": "REDUCE_SUM",
                                            "groupByFields": [
                                                "resource.labels.revision_name",
                                                "metric.labels.response_code_class"
                                            ]
                                        }
                                    }
                                }
                            }
                        ]
                    }
                }
            },
            {
                "xPos": 0,
                "yPos": 4,
                "width": 12,
                "height": 4,
                "widget": {
                    "title": "Latency p50 / p95 / p99 (ms) by revision",
                    "xyChart": {
                        "dataSets": [
                            {
                                "plotType": "LINE",
                                "legendTemplate": "p50 ${resource.labels.revision_name}",
                                "timeSeriesQuery": {
                                    "timeSeriesFilter": {
                                        "filter": "metric.type=\"run.googleapis.com/request_latencies\" resource.type=\"cloud_run_revision\" resource.labels.service_name=\"workshop-v3-api\"",
                                        "aggregation": {
                                            "alignmentPeriod": "60s",
                                            "perSeriesAligner": "ALIGN_DELTA",
                                            "crossSeriesReducer": "REDUCE_PERCENTILE_50",
                                            "groupByFields": [
                                                "resource.labels.revision_name"
                                            ]
                                        }
                                    }
                                }
                            },
                            {
                                "plotType": "LINE",
                                "legendTemplate": "p95 ${resource.labels.revision_name}",
                                "timeSeriesQuery": {
                                    "timeSeriesFilter": {
                                        "filter": "metric.type=\"run.googleapis.com/request_latencies\" resource.type=\"cloud_run_revision\" resource.labels.service_name=\"workshop-v3-api\"",
                                        "aggregation": {
                                            "alignmentPeriod": "60s",
                                            "perSeriesAligner": "ALIGN_DELTA",
                                            "crossSeriesReducer": "REDUCE_PERCENTILE_95",
                                            "groupByFields": [
                                                "resource.labels.revision_name"
                                            ]
                                        }
                                    }
                                }
                            },
                            {
                                "plotType": "LINE",
                                "legendTemplate": "p99 ${resource.labels.revision_name}",
                                "timeSeriesQuery": {
                                    "timeSeriesFilter": {
                                        "filter": "metric.type=\"run.googleapis.com/request_latencies\" resource.type=\"cloud_run_revision\" resource.labels.service_name=\"workshop-v3-api\"",
                                        "aggregation": {
                                            "alignmentPeriod": "60s",
                                            "perSeriesAligner": "ALIGN_DELTA",
                                            "crossSeriesReducer": "REDUCE_PERCENTILE_99",
                                            "groupByFields": [
                                                "resource.labels.revision_name"
                                            ]
                                        }
                                    }
                                }
                            }
                        ]
                    }
                }
            },
            {
                "xPos": 0,
                "yPos": 8,
                "width": 6,
                "height": 4,
                "widget": {
                    "title": "Saturation: CPU utilization p95 by revision",
                    "xyChart": {
                        "dataSets": [
                            {
                                "plotType": "LINE",
                                "legendTemplate": "${resource.labels.revision_name}",
                                "timeSeriesQuery": {
                                    "timeSeriesFilter": {
                                        "filter": "metric.type=\"run.googleapis.com/container/cpu/utilizations\" resource.type=\"cloud_run_revision\" resource.labels.service_name=\"workshop-v3-api\"",
                                        "aggregation": {
                                            "alignmentPeriod": "60s",
                                            "perSeriesAligner": "ALIGN_DELTA",
                                            "crossSeriesReducer": "REDUCE_PERCENTILE_95",
                                            "groupByFields": [
                                                "resource.labels.revision_name"
                                            ]
                                        }
                                    }
                                }
                            }
                        ]
                    }
                }
            },
            {
                "xPos": 6,
                "yPos": 8,
                "width": 6,
                "height": 4,
                "widget": {
                    "title": "Saturation: memory utilization p95 by revision",
                    "xyChart": {
                        "dataSets": [
                            {
                                "plotType": "LINE",
                                "legendTemplate": "${resource.labels.revision_name}",
                                "timeSeriesQuery": {
                                    "timeSeriesFilter": {
                                        "filter": "metric.type=\"run.googleapis.com/container/memory/utilizations\" resource.type=\"cloud_run_revision\" resource.labels.service_name=\"workshop-v3-api\"",
                                        "aggregation": {
                                            "alignmentPeriod": "60s",
                                            "perSeriesAligner": "ALIGN_DELTA",
                                            "crossSeriesReducer": "REDUCE_PERCENTILE_95",
                                            "groupByFields": [
                                                "resource.labels.revision_name"
                                            ]
                                        }
                                    }
                                }
                            }
                        ]
                    }
                }
            },
            {
                "xPos": 0,
                "yPos": 12,
                "width": 12,
                "height": 4,
                "widget": {
                    "title": "Business: service orders created per minute by revision",
                    "xyChart": {
                        "dataSets": [
                            {
                                "plotType": "STACKED_BAR",
                                "legendTemplate": "${resource.labels.revision_name}",
                                "timeSeriesQuery": {
                                    "timeSeriesFilter": {
                                        "filter": "metric.type=\"logging.googleapis.com/user/orders_created\" resource.type=\"cloud_run_revision\"",
                                        "aggregation": {
                                            "alignmentPeriod": "60s",
                                            "perSeriesAligner": "ALIGN_SUM",
                                            "crossSeriesReducer": "REDUCE_SUM",
                                            "groupByFields": [
                                                "resource.labels.revision_name"
                                            ]
                                        }
                                    }
                                }
                            }
                        ]
                    }
                }
            }
        ]
    }
}